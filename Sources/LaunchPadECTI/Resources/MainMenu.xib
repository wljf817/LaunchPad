<?xml version="1.0" encoding="UTF-8"?>
<!-- The text input service's main nib, written for LaunchPad with the objects and connections of the
     original service's nib (REF-SEARCH-011): the application delegate with its textField outlet, and a
     626 x 28 view holding the text field, whose cell is ECTITextInputCell. File's Owner (the
     application) has the class name ECTIHelperDelegate, as in the original. The main menu and the font
     manager its Font items target are the original's (REF-SEARCH-012): the service never shows the
     menu, but AppKit matches the key equivalents forwarded to the service against it. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23727" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
