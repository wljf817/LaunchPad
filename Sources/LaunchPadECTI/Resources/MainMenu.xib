    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="ECTIHelperDelegate">
            <connections>
                <outlet property="delegate" destination="7" id="8"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSApplication"/>
        <customObject id="7" customClass="ECTIHelperDelegate">
            <connections>
                <outlet property="textField" destination="10" id="11"/>
            </connections>
        </customObject>
        <customObject id="20" customClass="NSFontManager"/>
